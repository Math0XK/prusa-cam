# Copier vers /etc/prusa-cam.env puis remplir le token.
# Token obtenu dans Prusa Connect : imprimante > Caméras > "Ajouter une nouvelle autre caméra"
PRUSA_TOKEN=

# Intervalle entre deux photos (Prusa Connect n'en accepte pas plus d'une toutes les ~10 s)
INTERVAL=10

# Résolution / qualité JPEG (le Pi 1 est lent : 1280x720 est un bon compromis)
WIDTH=1280
HEIGHT=720
QUALITY=80

# Options rpicam-still supplémentaires, ex. caméra à l'envers : --rotation 180
EXTRA_ARGS=
